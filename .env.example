# Copy to .env and fill in. NEVER commit .env. Names only here.
# Comments on their own lines only: docker --env-file treats inline comments as values.
# mock | tokenfactory | ollama (local, free; for the eval dev loop)
HERBTWIN_BACKEND=mock
# Token Factory key
HERBTWIN_NEBIUS_API_KEY=
HERBTWIN_TOKENFACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# seconds per Token Factory call before giving up (default 60; reasoning models can need more)
HERBTWIN_TOKENFACTORY_TIMEOUT_S=60
# comma-separated model ids (or dedicated-endpoint routing keys) asked to skip reasoning
HERBTWIN_NO_THINKING_MODELS=
# Ollama's OpenAI-compatible endpoint, used when HERBTWIN_BACKEND=ollama
HERBTWIN_OLLAMA_BASE_URL=http://localhost:11434/v1/
# model ids: copy from the risk-gate report (scripts/risk_gate.py)
HERBTWIN_OBSERVE_MODEL=
# optional backup photo model, asked when the first fails or times out (e.g. deepseek-ai/DeepSeek-V4.1-Flash)
HERBTWIN_OBSERVE_FALLBACK_MODEL=
# seconds each photo model gets before the next is asked (default: HERBTWIN_TOKENFACTORY_TIMEOUT_S)
HERBTWIN_OBSERVE_TIMEOUT_S=
# the advisor, asked 3 times per photo: nvidia/nemotron-3-super-120b-a12b
HERBTWIN_ADVISE_MODEL=
# the follow-up chat's model (its tool loop); unset: the advisor. Live: Nemotron 3 Nano,
# listed in HERBTWIN_NO_THINKING_MODELS too (with reasoning on it skips the plant model)
HERBTWIN_FAST_MODEL=
# the trusted-page check's reader, thinking off (default nvidia/Nemotron-3-Ultra-550b-a55b, the
# model its test passed on). The check runs only with Tavily on and the chat's search on.
HERBTWIN_CHECK_MODEL=
# the trusted-page check itself: on unless set to 0 (it also needs Tavily and the search on)
HERBTWIN_TRUSTED_CHECK=
# Web search in the follow-up chat (off by default). On: set to 1 and add a key.
# The chain is Tavily, then Exa, then TinyFish, then none; trusted gardening sites only.
HERBTWIN_SEARCH_ENABLED=
# Tavily is used only while this is 1 (off by default, to save credits in development):
# chat search, finding a plant's RHS page, and reading a page the free readers could not
HERBTWIN_TAVILY_ENABLED=
HERBTWIN_TAVILY_API_KEY=
# "Shops we found for this" under the answer: 1 to show it (needs Tavily on). Known UK garden
# retailers only, never a chemical; one search per kind of thing, kept for a week
HERBTWIN_SHOP_LINKS=
# optional affiliate links, one template per retailer, off unless set:
# diy.com=https://example.com/track?u={url};crocus.co.uk=https://…{url}
HERBTWIN_SHOP_AFFILIATES=
# Tavily calls a day for the shop links and local help together (default 200); at the
# ceiling the extras show nothing until the next day
HERBTWIN_SHOP_DAILY_SEARCHES=
# "Gardeners near <town>" under the answer, for someone who typed a UK town or postcode: 1 to
# show it (needs Tavily on). The town goes to Tavily; known directories only, kept a week
HERBTWIN_LOCAL_HELP=
# "Seen recently in the UK" under Keep an eye on: GBIF's UK records of the plant's pests and
# diseases from the last 60 days (free, no key; GBIF gets only a species and the dates). On
# unless set to 0. Its news headlines need Tavily on
HERBTWIN_SIGHTINGS=
HERBTWIN_EXA_API_KEY=
# TinyFish (free): chat search, finding a plant's RHS page, and reading pages
HERBTWIN_TINYFISH_API_KEY=
# LangSmith traces of model calls (D64): on only when the key is set. The project defaults
# to herbtwin-dev; deploy sets herbtwin-live
HERBTWIN_LANGSMITH_API_KEY=
HERBTWIN_LANGSMITH_PROJECT=
# The LangSmith host for the account's region, e.g. https://eu.api.smith.langchain.com (default: US)
HERBTWIN_LANGSMITH_ENDPOINT=
# OpenPlantBook API (free account at open.plantbook.io): light and soil-moisture bands for a
# plant with no RHS page (research stage)
HERBTWIN_OPENPLANTBOOK_CLIENT_ID=
HERBTWIN_OPENPLANTBOOK_CLIENT_SECRET=
# optional developer fallback when a photo has no location (deploy leaves both unset),
# e.g. 51.50 and -0.12; set both or neither
HERBTWIN_HOME_LAT=
HERBTWIN_HOME_LON=
# raw photos, gitignored; the risk gate and live test read <dir>/gate/<herb>.jpg
HERBTWIN_PHOTOS_DIR=data/photos
# Accounts and plant history (optional; see docs/SUPABASE.md). With URL and publishable
# key unset the app has no sign-in. The secret key is read only by account delete and
# scripts/export_scored_pairs.py (run locally).
HERBTWIN_SUPABASE_URL=
HERBTWIN_SUPABASE_PUBLISHABLE_KEY=
HERBTWIN_SUPABASE_SECRET_KEY=
# the app's own address (no trailing slash): Secure cookies on https and the sign-in
# button's same-site check. Keep it equal to the dashboard's Site URL, which builds the
# emailed link (docs/SUPABASE.md)
HERBTWIN_SITE_URL=http://localhost:8000
# The live site (Cloud Run behind the Cloudflare Worker). Unset locally.
# The Worker's shared secret: requests without it are refused (except /health)
HERBTWIN_EDGE_SECRET=
# Photo-read caps and the live budget, counted in Supabase with the secret key. Only the live
# site sets this to 1; local runs never write to the hosted counters
HERBTWIN_CAPS_ENABLED=
# reads a day site-wide (default 200) and per visitor (default 10); days run on UK time
HERBTWIN_DAILY_READS=
HERBTWIN_VISITOR_READS=
# the live budget in US dollars (default 20) and the estimated cost of one read (default 0.005)
HERBTWIN_LIVE_BUDGET_USD=
HERBTWIN_READ_COST_USD=
# refines and chat messages also add to the live budget and stop with it: the estimated
# cost of one refine (default 0.003) and one chat message (default 0.001)
HERBTWIN_REFINE_COST_USD=
HERBTWIN_CHAT_COST_USD=
HERBTWIN_VOICE_COST_USD=
# the judges' code, typed on /judge: skips the caps and the budget stop. Unset: no /judge page
HERBTWIN_JUDGE_CODE=
# The email at 80% of the live budget, sent through Resend: all three, or no email
HERBTWIN_RESEND_API_KEY=
# the sender, on a domain verified in Resend, e.g. herbtwin <alerts@your.domain>
HERBTWIN_MAIL_FROM=
# where the warning goes
HERBTWIN_ALERT_EMAIL=
# "Hear it from your plant": the answer read aloud through ElevenLabs. Off since 21 Oct: the
# button shows only with the key set AND HERBTWIN_VOICE_ENABLED=1
HERBTWIN_ELEVENLABS_API_KEY=
HERBTWIN_VOICE_ENABLED=
# signs the unsubscribe link in re-photo reminder emails; unset, the reminder box is hidden
HERBTWIN_REMINDER_SECRET=
# "What can I grow here?" (spot spec): 1 on the live site; unset locally hides the entry,
# the spot routes and the plant answer's spot questions
HERBTWIN_SPOT_ENABLED=
